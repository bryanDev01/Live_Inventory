			width: min(100% - 2rem, 72rem);
			min-height: 100svh;
			margin-inline: auto;
		}

		.section-label {
			margin: 0 0 0.5rem;
			color: var(--color-accent);
			font-size: 0.8125rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: uppercase;
		}

		h1,
		h2,
		h3,
		p {
			margin-top: 0;
		}

		.login-view {
			max-width: 72rem;
			margin-inline: auto;
			display: grid;
			grid-template-columns: 1.1fr 0.9fr;
			align-items: center;
			gap: clamp(2rem, 7vw, 5rem);
			min-height: 100svh;
			padding-block: 3rem;
		}

		.login-view h1 {
			max-width: 13ch;
			margin-bottom: 1rem;
			font-size: clamp(2.2rem, 4vw, 3.2rem);
			letter-spacing: -0.03em;
			line-height: 1.08;
		}

		.intro-copy,
		.home-copy,
		.panel-copy,
		.panel-note,
		.product-meta,
		.empty-state {
			color: var(--color-muted);
		}

		.intro-copy {
			max-width: 34rem;
			margin-bottom: 0;
			font-size: 1.125rem;
		}

		.panel {
			border: 1px solid var(--color-border);
			border-radius: var(--radius-panel);
			background: var(--color-surface);
			padding: clamp(1.25rem, 3vw, 2rem);
		}

		.access-panel h2,
		.panel h2 {
			margin-bottom: 0.5rem;
			font-size: 1.5rem;
			letter-spacing: -0.02em;
			line-height: 1.2;
		}

		.field-group {
			margin-bottom: 1rem;
		}

		label {
			display: block;
			margin-bottom: 0.35rem;
			font-weight: 600;
		}

		input {
			width: 100%;
			min-height: 3rem;
			padding: 0.6rem 0.75rem;
			border: 1px solid var(--color-border);
			border-radius: var(--radius-field);
			background: var(--color-surface);
			color: var(--color-ink);
		}

		input:focus-visible {
			border-color: var(--color-accent);
		}

		.primary-button,
		.secondary-button {
			min-height: 3rem;
			padding: 0.6rem 1rem;
			border-radius: var(--radius-button);
			font-weight: 700;
			cursor: pointer;
		}

		.primary-button {
			width: 100%;
			border: 1px solid var(--color-accent);
			background: var(--color-accent);
			color: var(--color-on-accent);
		}

		.primary-button:hover:not(:disabled) {
			border-color: var(--color-accent-hover);
			background: var(--color-accent-hover);
		}

		.primary-button.compact {
			width: auto;
			align-self: end;
		}

		.secondary-button {
			border: 1px solid var(--color-border);
			background: var(--color-surface);
			color: var(--color-ink);
		}

		.secondary-button:hover:not(:disabled) {
			border-color: var(--color-accent);
			color: var(--color-accent);
		}

		.primary-button:disabled,
		.secondary-button:disabled {
			cursor: not-allowed;
			opacity: 0.65;
		}

		.link-button {
			border: 0;
			background: none;
			padding: 0;
			color: var(--color-accent);
			font-weight: 600;
