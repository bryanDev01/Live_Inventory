---
const { admin = false } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'https://br-empty-heart-beae9njz-api.compute.c-9.us-east-2.aws.neon.tech';
---


	<main class="app-shell" data-api={apiUrl} data-admin={admin ? '1' : '0'}>
		<section class="login-view" id="login-view" aria-labelledby="login-title" hidden={!admin}>
			<div class="intro-panel">
				<p class="section-label">Inventario privado</p>
				<h1>Tu inventario, con la tasa a la vista.</h1>
				<p class="intro-copy">
					Registra productos con precio de compra y venta. La app calcula el equivalente en CUP y la ganancia.
					Tú decides si cambias el precio de venta.
				</p>
			</div>

			<section class="panel access-panel" aria-labelledby="login-title">
				<p class="section-label">Acceso</p>
				<h2 id="login-title">Iniciar sesión</h2>

				<form id="login-form" novalidate>
					<div class="field-group">
						<label for="user-name">Nombre</label>
						<input id="user-name" name="name" type="text" autocomplete="username" required />
					</div>
					<div class="field-group">
						<label for="user-password">Contraseña</label>
						<input id="user-password" name="password" type="password" autocomplete="current-password" required />
					</div>
					<p class="form-error" id="login-error" role="alert" hidden></p>
					<button class="primary-button" id="login-submit" type="submit">Entrar</button>
				</form>
			</section>
		</section>

		<section class="home-view" id="home-view" aria-labelledby="welcome-title" hidden={admin}>
			<header class="home-header">
				<div>
					<p class="section-label">Inventario privado</p>
					<h1 id="welcome-title">Bienvenido</h1>
					<p class="day-caption">Tasa del día</p>
					<p class="day-rate" id="day-rate">Sin tasa</p>
					<p class="home-copy" id="rate-summary">Cargando la tasa.</p>
				</div>
				<button class="secondary-button" id="logout-button" type="button">Salir</button>
			</header>

			<section class="panel alerts-panel" id="alerts-panel" aria-labelledby="alerts-title" hidden>
				<div class="panel-heading">
					<div>
						<p class="section-label">Avisos</p>
						<h2 id="alerts-title">Cambios en la tasa</h2>
					</div>
					<div class="alerts-actions">
						<button class="secondary-button compact" id="enable-notifications" type="button" hidden>Activar avisos en este dispositivo</button>
						<button class="link-button" id="read-all" type="button">Marcar todas como leídas</button>
					</div>
				</div>
				<ul class="alert-list" id="alert-list"></ul>
			</section>

			<div class="content-grid">
				<section class="panel" id="rate-panel" aria-labelledby="rate-title" hidden>
					<p class="section-label">Tasa de referencia</p>
					<h2 id="rate-title">CUP por 1 USD</h2>
					<p class="panel-copy" id="rate-status">Sin tasa registrada.</p>

					<form id="rate-form" class="inline-form" novalidate>
						<div class="field-group">
							<label for="rate-value">Nueva tasa</label>
							<input id="rate-value" name="rate" type="text" inputmode="decimal" placeholder="Ejemplo: 520.50" />
						</div>
						<button class="primary-button compact" type="submit">Guardar tasa</button>
					</form>
					<p class="form-error" id="rate-error" role="alert" hidden></p>
					<p class="panel-note">
						La tasa de referencia se actualiza desde el servidor. Queda registrada con su hora.
						Nunca se cambia el precio de venta automáticamente.
					</p>
				</section>

				<section class="panel" id="mode-panel" aria-labelledby="mode-title" hidden>
					<p class="section-label">Ganancia</p>
					<h2 id="mode-title">Qué porcentaje ves primero</h2>
					<p class="panel-copy">Los dos porcentajes se calculan siempre. Elige cuál quieres ver primero.</p>

					<form id="mode-form" class="mode-options">
						<label class="mode-option">
							<input type="radio" name="profitMode" value="margin" />
							<span><strong>Ganancia sobre la venta</strong> (porcentaje del precio de venta)</span>
						</label>
						<label class="mode-option">
							<input type="radio" name="profitMode" value="markup" />
							<span><strong>Ganancia sobre la compra</strong> (porcentaje del precio de compra)</span>
						</label>
					</form>
					<p class="form-error" id="mode-error" role="alert" hidden></p>
				</section>
			</div>

			<section class="panel products-panel" aria-labelledby="products-title">
				<div class="panel-heading">
					<div>
						<p class="section-label">Productos</p>
						<h2 id="products-title">Lista</h2>
					</div>
					<p class="count-badge" id="product-count">0 productos</p>
				</div>

				<form id="product-form" class="product-form" novalidate>
					<div class="field-group">
						<label for="product-name">Nombre</label>
						<input id="product-name" name="name" type="text" required />
					</div>
					<div class="field-group">
						<label for="product-purchase">Precio de compra</label>
						<input id="product-purchase" name="purchaseAmount" type="text" inputmode="decimal" required />
					</div>
					<div class="field-group">
						<label for="product-purchase-currency">Moneda de compra</label>
						<select id="product-purchase-currency" name="purchaseCurrency" required></select>
					</div>
					<div class="field-group">
						<label for="product-sale">Precio de venta</label>
						<input id="product-sale" name="saleAmount" type="text" inputmode="decimal" required />
					</div>
					<div class="field-group">
						<label for="product-sale-currency">Moneda de venta</label>
						<select id="product-sale-currency" name="saleCurrency" required></select>
					</div>
					<div class="field-group">
						<label for="product-limit">Límite de ganancia (%)</label>
						<input id="product-limit" name="profitLimit" type="text" inputmode="decimal" value="10" />
					</div>
					<button class="primary-button compact" id="product-submit" type="submit">Añadir producto</button>
				</form>
				<p class="form-error" id="product-error" role="alert" hidden></p>

				<p class="empty-state" id="products-empty">Todavía no hay productos.</p>
				<p class="list-summary" id="list-summary" hidden></p>

				<div class="table-wrap">
					<table class="product-table">
						<thead>
							<tr>
								<th scope="col">Producto</th>
								<th scope="col">Compra</th>
								<th scope="col">Compra en CUP</th>
								<th scope="col">Venta</th>
								<th scope="col">Venta en CUP</th>
								<th scope="col">Ganancia o pérdida</th>
								<th scope="col">Sobre la venta</th>
								<th scope="col">Sobre la compra</th>
								<th scope="col">Límite</th>
								<th scope="col">Acciones</th>
							</tr>
						</thead>
						<tbody id="product-list"></tbody>
					</table>
				</div>

				<nav class="pagination" id="pagination" aria-label="Paginación de productos" hidden>
					<button class="secondary-button compact" id="prev-page" type="button">Anterior</button>
					<p class="page-info" id="page-info"></p>
					<button class="secondary-button compact" id="next-page" type="button">Siguiente</button>
				</nav>
			</section>

			<section class="panel import-panel" aria-labelledby="import-title">
				<p class="section-label">Carga masiva</p>
				<h2 id="import-title">Importar desde Excel o Word</h2>
				<p class="panel-copy">
					El archivo debe tener una tabla con estas columnas: nombre, precio de compra, moneda de compra,
					precio de venta, moneda de venta. Primero verás una vista previa; nada se guarda hasta que lo confirmes.
				</p>

				<div class="import-controls">
					<div class="field-group">
						<label for="import-file">Archivo .xlsx o .docx</label>
						<input id="import-file" type="file" accept=".xlsx,.xls,.docx" />
					</div>
					<button class="secondary-button compact" id="import-preview" type="button">Ver vista previa</button>
					<button class="primary-button compact" id="import-apply" type="button" disabled>Importar filas válidas</button>
				</div>
				<p class="form-error" id="import-error" role="alert" hidden></p>
				<p class="panel-note" id="import-summary" hidden></p>

				<div class="import-table-wrap" id="import-table-wrap" hidden>
					<table class="import-table">
						<thead>
							<tr>
								<th scope="col">Fila</th>
								<th scope="col">Nombre</th>
								<th scope="col">Compra</th>
								<th scope="col">Moneda</th>
								<th scope="col">Venta</th>
								<th scope="col">Moneda</th>
								<th scope="col">Estado</th>
							</tr>
						</thead>
						<tbody id="import-rows"></tbody>
					</table>
				</div>
			</section>
		</section>
	</main>

	<template id="product-template">
		<tr class="product-row">
			<td class="cell-name" data-label="Producto">
				<span class="product-name"></span>
				<span class="row-note"></span>
			</td>
			<td class="cell-number product-purchase" data-label="Compra"></td>
			<td class="cell-number product-purchase-cup" data-label="Compra en CUP"></td>
			<td class="cell-number product-sale" data-label="Venta"></td>
			<td class="cell-number product-sale-cup" data-label="Venta en CUP"></td>
			<td class="cell-number product-result" data-label="Ganancia o pérdida"></td>
			<td class="cell-number product-margin" data-label="Sobre la venta"></td>
			<td class="cell-number product-markup" data-label="Sobre la compra"></td>
			<td class="cell-number product-limit" data-label="Límite"></td>
			<td class="cell-actions" data-label="Acciones">
				<button class="link-button product-edit" type="button">Editar</button>
				<button class="link-button product-remove" type="button">Eliminar</button>
			</td>
		</tr>
	</template>

	<script>
		const shell = document.querySelector<HTMLElement>('.app-shell');
		const apiUrl = shell?.dataset.api ?? '';
		const isAdmin = shell?.dataset.admin === '1';

		const loginView = document.querySelector<HTMLElement>('#login-view');
		const homeView = document.querySelector<HTMLElement>('#home-view');
		const loginForm = document.querySelector<HTMLFormElement>('#login-form');
		const loginError = document.querySelector<HTMLElement>('#login-error');
		const loginSubmit = document.querySelector<HTMLButtonElement>('#login-submit');
		const logoutButton = document.querySelector<HTMLButtonElement>('#logout-button');
		const welcomeTitle = document.querySelector<HTMLElement>('#welcome-title');
		const rateSummary = document.querySelector<HTMLElement>('#rate-summary');
		const rateStatus = document.querySelector<HTMLElement>('#rate-status');
		const dayRate = document.querySelector<HTMLElement>('#day-rate');
		const alertsPanel = document.querySelector<HTMLElement>('#alerts-panel');
		const alertList = document.querySelector<HTMLUListElement>('#alert-list');
		const readAllButton = document.querySelector<HTMLButtonElement>('#read-all');
		const enableNotifications = document.querySelector<HTMLButtonElement>('#enable-notifications');
		const rateForm = document.querySelector<HTMLFormElement>('#rate-form');
		const rateValue = document.querySelector<HTMLInputElement>('#rate-value');
		const rateError = document.querySelector<HTMLElement>('#rate-error');
		const modeForm = document.querySelector<HTMLFormElement>('#mode-form');
		const modeError = document.querySelector<HTMLElement>('#mode-error');
		const productForm = document.querySelector<HTMLFormElement>('#product-form');
		const productError = document.querySelector<HTMLElement>('#product-error');
		const productSubmit = document.querySelector<HTMLButtonElement>('#product-submit');
		const purchaseCurrency = document.querySelector<HTMLSelectElement>('#product-purchase-currency');
		const saleCurrency = document.querySelector<HTMLSelectElement>('#product-sale-currency');
		const importFile = document.querySelector<HTMLInputElement>('#import-file');
		const importPreview = document.querySelector<HTMLButtonElement>('#import-preview');
		const importApply = document.querySelector<HTMLButtonElement>('#import-apply');
		const importError = document.querySelector<HTMLElement>('#import-error');
		const importSummary = document.querySelector<HTMLElement>('#import-summary');
		const importTableWrap = document.querySelector<HTMLElement>('#import-table-wrap');
		const importRows = document.querySelector<HTMLElement>('#import-rows');
		const pagination = document.querySelector<HTMLElement>('#pagination');
		const pageInfo = document.querySelector<HTMLElement>('#page-info');
		const prevPage = document.querySelector<HTMLButtonElement>('#prev-page');
		const nextPage = document.querySelector<HTMLButtonElement>('#next-page');
		const listSummary = document.querySelector<HTMLElement>('#list-summary');
		const productList = document.querySelector<HTMLTableSectionElement>('#product-list');
		const productsEmpty = document.querySelector<HTMLElement>('#products-empty');
		const productCount = document.querySelector<HTMLElement>('#product-count');
		const template = document.querySelector<HTMLTemplateElement>('#product-template');

		type Rate = { cupPerUnit: string; source: string; observedAt: string; fetchedAt: string };
		type Product = {
			id: string;
			name: string;
			purchaseAmount: string;
			purchaseCurrency: string;
			saleAmount: string;
			saleCurrency: string;
			cupEquivalent: string | null;
			cupUnavailable: string | null;
			rate: Rate | null;
			profitMargin: string | null;
			profitMarkup: string | null;
			profitCup: string | null;
			profitLimit: string;
			profitUnavailable?: string | null;
			saleCupEquivalent?: string | null;
		};
		type Session = { token: string; name: string; role: string };

		let session: Session | null = null;
		let profitMode: 'margin' | 'markup' | null = null;
		let currentProducts: Product[] = [];
		let currencies: string[] = [];
		let currentPage = 1;
		let totalPages = 1;
		let totalItems = 0;

		function showError(element: HTMLElement | null, message: string) {
			if (!element) return;
			element.textContent = message;
			element.hidden = !message;
		}

		function clearErrors() {
			showError(loginError, '');
			showError(rateError, '');
			showError(modeError, '');
			showError(productError, '');
			showError(importError, '');
		}

		function fillCurrencies(list: string[]) {
			currencies = list;
			for (const select of [purchaseCurrency, saleCurrency]) {
				if (!select) continue;
				const previous = select.value;
				select.textContent = '';
				const placeholder = document.createElement('option');
				placeholder.value = '';
				placeholder.textContent = 'Elige';
				select.append(placeholder);
				for (const code of currencies) {
					const option = document.createElement('option');
					option.value = code;
					option.textContent = code;
					select.append(option);
				}
				select.value = currencies.includes(previous) ? previous : '';
			}
		}

		async function loadCurrencies() {
			const result = await request<{ currencies: string[] }>('/currencies', {}, session?.token);
			fillCurrencies(result.currencies);
		}

		type ImportRow = {
			row: number;
			values: { name: string; purchaseAmount: string; purchaseCurrency: string; saleAmount: string; saleCurrency: string };
			status: 'ok' | 'error' | 'duplicate';
			errors: string[];
		};
		type ImportResult = { token?: string; summary: { total: number; ok: number; errors: number; duplicates: number }; rows: ImportRow[]; inserted?: number; warnings?: string[] };
		let importToken = '';

		function renderImport(result: ImportResult) {
			if (!importRows || !importSummary || !importTableWrap) return;

			importRows.textContent = '';
			for (const item of result.rows) {
				const tr = document.createElement('tr');
				const cells = [
					String(item.row),
					item.values.name,
					item.values.purchaseAmount,
					item.values.purchaseCurrency,
					item.values.saleAmount,
					item.values.saleCurrency,
				];
				for (const value of cells) {
					const td = document.createElement('td');
					td.textContent = value || '—';
					tr.append(td);
				}
				const status = document.createElement('td');
				status.className = `import-status is-${item.status}`;
				status.textContent =
					item.status === 'ok' ? 'Válida' : item.status === 'duplicate' ? 'Duplicada' : item.errors.join(' ');
				tr.append(status);
				importRows.append(tr);
			}

			importSummary.hidden = false;
			const base = `${result.summary.total} filas: ${result.summary.ok} válidas, ${result.summary.errors} con error, ${result.summary.duplicates} duplicadas.`;
			importSummary.textContent = result.warnings?.length ? `${base} ${result.warnings.join(' ')}` : base;
			importTableWrap.hidden = false;
			if (importApply) importApply.disabled = result.summary.ok === 0;
		}

		async function sendImport(mode: 'preview' | 'apply'): Promise<ImportResult> {
			if (!importFile?.files?.length) throw new Error('Elige un archivo primero');

			const file = importFile.files[0];
			const buffer = await file.arrayBuffer();
			const bytes = new Uint8Array(buffer);
			let binary = '';
			const chunk = 0x8000;
			for (let index = 0; index < bytes.length; index += chunk) {
				binary += String.fromCharCode(...bytes.subarray(index, index + chunk));
			}
			const dataBase64 = btoa(binary);

			const response = await fetch(`${apiUrl}/products/import`, {
				method: 'POST',
				headers: { 'content-type': 'application/json', authorization: `Bearer ${session?.token}` },
				body: JSON.stringify({ filename: file.name, dataBase64, mode, token: importToken }),
			});
			const text = await response.text();
			const parsed = text ? JSON.parse(text) : null;
			if (!response.ok) throw new Error(parsed?.error ?? `Error ${response.status}`);
			if (parsed?.token) importToken = parsed.token;
			return parsed as ImportResult;
		}

		async function request<T>(path: string, init: RequestInit = {}, token?: string): Promise<T> {
			const headers: Record<string, string> = { 'content-type': 'application/json', ...(init.headers as Record<string, string>) };
			if (token) headers.authorization = `Bearer ${token}`;

			const response = await fetch(`${apiUrl}${path}`, { ...init, headers });
			const text = await response.text();
			const body = text ? JSON.parse(text) : null;

			if (!response.ok) {
				throw new Error(body?.error ?? `Error ${response.status}`);
			}
			return body as T;
		}

		function formatCup(value: string | null): string {
			if (value === null) return 'Sin tasa';
			return `${value} CUP`;
		}

		function formatPercent(value: string | null): string {
			if (value === null) return 'No disponible';
			return `${value}%`;
		}

		function addCup(amounts: string[]): string {
			let total = 0n;
			for (const value of amounts) {
				const negative = value.startsWith('-');
				const clean = negative ? value.slice(1) : value;
				const [whole, fraction = ''] = clean.split('.');
				const cents = BigInt(whole) * 100n + BigInt((fraction + '00').slice(0, 2));
				total += negative ? -cents : cents;
			}
			const negativeTotal = total < 0n;
			const absolute = negativeTotal ? -total : total;
			const whole = absolute / 100n;
			const fraction = String(absolute % 100n).padStart(2, '00');
			return `${negativeTotal ? '-' : ''}${whole}.${fraction}`;
		}

		function formatTime(value: string): string {
			return new Date(value).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short' });
		}

		function renderRate(rate: Rate | null) {
			if (!rateStatus || !rateSummary) return;
			if (!rate) {
				if (dayRate) dayRate.textContent = 'Sin tasa';
				rateStatus.textContent = isAdmin
					? 'Sin tasa registrada. Añade una para ver los equivalentes en CUP.'
					: 'Sin tasa registrada todavía.';
				rateSummary.textContent = 'Sin tasa de referencia.';
				return;
			}
			if (dayRate) dayRate.textContent = `${rate.cupPerUnit} CUP`;
			rateStatus.textContent = `${rate.cupPerUnit} CUP por 1 USD. Registrada ${formatTime(rate.observedAt)}.`;
			rateSummary.textContent = `1 USD = ${rate.cupPerUnit} CUP. Actualizada ${formatTime(rate.observedAt)}.`;
		}

		type Alert = {
			id: string;
			productName: string;
			profitPercent: string;
			profitLimit: string;
			rate: string;
			createdAt: string;
			read: boolean;
		};

		const LAST_ALERT_KEY = 'inventory-last-alert-id';
		let pushReady = false;

		function alertMessage(alert: Alert): string {
			return `${alert.productName}: la ganancia sobre el costo bajó a ${alert.profitPercent}%, por debajo de tu límite de ${alert.profitLimit}%. Revisa su precio de venta.`;
		}

		function notifyNewAlerts(alerts: Alert[]) {
			const maxId = alerts.reduce((max, alert) => Math.max(max, Number(alert.id)), 0);
			const stored = localStorage.getItem(LAST_ALERT_KEY);

			// First visit only records a baseline, so old alerts are not replayed as notifications.
			if (stored === null) {
				localStorage.setItem(LAST_ALERT_KEY, String(maxId));
				return;
			}

			const fresh = alerts.filter((alert) => Number(alert.id) > Number(stored) && !alert.read);
			if (fresh.length > 0 && 'Notification' in window && Notification.permission === 'granted') {
				for (const alert of fresh.slice(0, 3)) {
					new Notification('Cambio en la tasa', { body: alertMessage(alert), lang: 'es' });
				}
			}
			localStorage.setItem(LAST_ALERT_KEY, String(maxId));
		}

		function urlBase64ToUint8Array(base64: string): Uint8Array {
			const padding = '='.repeat((4 - (base64.length % 4)) % 4);
			const normalized = (base64 + padding).replace(/-/g, '+').replace(/_/g, '/');
			const raw = atob(normalized);
			const output = new Uint8Array(raw.length);
			for (let index = 0; index < raw.length; index += 1) output[index] = raw.charCodeAt(index);
			return output;
		}

		async function enablePush(): Promise<void> {
			if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
				throw new Error('Este navegador no admite avisos en segundo plano.');
			}

			const permission = await Notification.requestPermission();
			if (permission !== 'granted') throw new Error('El permiso de avisos fue denegado.');

			await navigator.serviceWorker.register('/sw.js');
			const registration = await navigator.serviceWorker.ready;

			const keyResponse = await request<{ key: string | null }>('/push/key', {}, session?.token);
			if (!keyResponse.key) throw new Error('Los avisos no están configurados en el servidor.');

			let subscription = await registration.pushManager.getSubscription();
			if (!subscription) {
				subscription = await registration.pushManager.subscribe({
					userVisibleOnly: true,
					applicationServerKey: urlBase64ToUint8Array(keyResponse.key),
				});
			}

			const json = subscription.toJSON();
			if (!json.endpoint || !json.keys?.p256dh || !json.keys?.auth) {
				throw new Error('El navegador no entregó una suscripción válida.');
			}

			await request(
				'/push/subscribe',
				{
					method: 'POST',
					body: JSON.stringify({ endpoint: json.endpoint, p256dh: json.keys.p256dh, auth: json.keys.auth }),
				},
				session?.token,
			);

			pushReady = true;
			if (enableNotifications) enableNotifications.hidden = true;
		}

		let maxAlertId = 0;

		function renderAlerts(alerts: Alert[]) {
			if (!alertsPanel || !alertList) return;

			maxAlertId = alerts.reduce((max, alert) => Math.max(max, Number(alert.id)), 0);
			const localRead = Number(localStorage.getItem('inventory-public-read-id') ?? '0');
			// Public visitors keep their read state in the browser; there is no account behind them.
			const unread = alerts.filter((alert) => (isAdmin ? !alert.read : Number(alert.id) > localRead));
			alertsPanel.hidden = unread.length === 0;
			alertList.textContent = '';

			for (const alert of unread) {
				const item = document.createElement('li');
				item.className = 'alert-item';

				const text = document.createElement('p');
				text.className = 'alert-text';
				text.textContent = alertMessage(alert);

				const meta = document.createElement('p');
				meta.className = 'alert-meta';
				meta.textContent = formatTime(alert.createdAt);

				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'link-button';
				button.textContent = 'Marcar como leída';
				button.addEventListener('click', () => void markAlertsRead(alert.id));

				item.append(text, meta, button);
				alertList.append(item);
			}

			if (readAllButton) readAllButton.hidden = unread.length === 0;
			if (enableNotifications) {
				const supported = 'serviceWorker' in navigator && 'PushManager' in window;
				enableNotifications.hidden = !supported || pushReady;
			}
		}

		async function loadAlerts() {
			const result = await request<{ alerts: Alert[]; unread: number }>('/alerts', {}, session?.token);
			notifyNewAlerts(result.alerts);
			renderAlerts(result.alerts);
		}

		async function markAlertsRead(id?: string) {
			if (!isAdmin) {
				const target = id ? Number(id) : maxAlertId;
				const current = Number(localStorage.getItem('inventory-public-read-id') ?? '0');
				if (target > current) localStorage.setItem('inventory-public-read-id', String(target));
				await loadAlerts();
				return;
			}
			if (!session) return;
			await request('/alerts/read', { method: 'POST', body: JSON.stringify(id ? { id } : { all: true }) }, session?.token);
			await loadAlerts();
		}

		function renderProducts(products: Product[]) {
			if (!productList || !template || !productsEmpty || !productCount) return;

			currentProducts = products;
			productList.textContent = '';
			productCount.textContent = products.length === 1 ? '1 producto' : `${products.length} productos`;
			productsEmpty.hidden = products.length > 0;

			for (const product of products) {
				const node = template.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
				if (!node) continue;

				node.dataset.id = product.id;
				node.querySelector(".product-name")!.textContent = product.name;
				node.querySelector(".product-purchase")!.textContent = `${product.purchaseAmount} ${product.purchaseCurrency}`;
				node.querySelector(".product-sale")!.textContent = `${product.saleAmount} ${product.saleCurrency}`;
				node.querySelector(".product-purchase-cup")!.textContent = formatCup(product.cupEquivalent);
				node.querySelector(".product-sale-cup")!.textContent = formatCup(product.saleCupEquivalent ?? null);

				const result = node.querySelector(".product-result")!;
				if (product.profitCup !== null) {
					const negative = product.profitCup.startsWith("-");
					const amount = negative ? product.profitCup.slice(1) : product.profitCup;
					result.textContent = `${negative ? "Pérdida" : "Ganancia"} ${amount} CUP`;
					result.classList.toggle("is-loss", negative);
				} else {
					result.textContent = "Sin tasa";
				}

				const margin = node.querySelector(".product-margin")!;
				const markup = node.querySelector(".product-markup")!;
				margin.textContent = formatPercent(product.profitMargin);
				markup.textContent = formatPercent(product.profitMarkup);

				const limitCell = node.querySelector('.product-limit')!;
				limitCell.textContent = `${product.profitLimit}%`;
				const below =
					product.profitMarkup !== null &&
					Number(product.profitMarkup) <= Number(product.profitLimit);
				limitCell.classList.toggle('is-below', below);
				margin.classList.toggle("is-primary", profitMode === "margin");
				markup.classList.toggle("is-primary", profitMode === "markup");

				const meta: string[] = [];
				if (product.cupUnavailable) meta.push(`Falta la tasa para ${product.purchaseCurrency}.`);
				if (product.profitUnavailable) {
					meta.push(`Falta la tasa para ${product.profitUnavailable.replace("no-rate-for-", "")}.`);
				}
				if (product.rate && session?.role === "admin") {
					meta.push(`Tasa usada: ${product.rate.cupPerUnit} (${formatTime(product.rate.observedAt)}).`);
				}
				node.querySelector(".row-note")!.textContent = meta.join(" ");

				productList.append(node);
			}

			if (listSummary) {
				const withProfit = products.filter((product) => product.profitCup !== null);
				if (withProfit.length === 0) {
					listSummary.hidden = products.length === 0;
					listSummary.textContent = products.length === 0 ? '' : 'Sin tasa registrada: todavía no se puede calcular la ganancia.';
				} else {
					const total = addCup(withProfit.map((product) => product.profitCup as string));
					const negative = total.startsWith('-');
					const amount = negative ? total.slice(1) : total;
					const missing = products.length - withProfit.length;
					listSummary.hidden = false;
					listSummary.textContent =
						`En esta página: ${negative ? 'pérdida' : 'ganancia'} de ${amount} CUP` +
						(missing > 0 ? `, ${missing} producto(s) sin tasa para calcular.` : '.');
					listSummary.classList.toggle('is-loss', negative);
				}
			}
		}

		function renderMode() {
			if (!modeForm) return;
			for (const input of modeForm.querySelectorAll<HTMLInputElement>('input[name="profitMode"]')) {
				input.checked = profitMode !== null && input.value === profitMode;
			}
		}

		function startEdit(card: HTMLElement, product: Product) {
			if (card.querySelector('.product-edit-form')) return;

			const form = document.createElement('form');
			form.className = 'product-edit-form';
			form.innerHTML = `
				<div class="edit-grid">
					<div class="field-group"><label>Nombre</label><input name="name" type="text" /></div>
					<div class="field-group"><label>Precio de compra</label><input name="purchaseAmount" type="text" inputmode="decimal" /></div>
					<div class="field-group"><label>Moneda de compra</label><select name="purchaseCurrency"></select></div>
					<div class="field-group"><label>Precio de venta</label><input name="saleAmount" type="text" inputmode="decimal" /></div>
					<div class="field-group"><label>Moneda de venta</label><select name="saleCurrency"></select></div>
					<div class="field-group"><label>Límite (%)</label><input name="profitLimit" type="text" inputmode="decimal" /></div>
				</div>
				<p class="form-error" role="alert" hidden></p>
				<div class="edit-actions">
					<button class="primary-button compact" type="submit">Guardar cambios</button>
					<button class="secondary-button compact" type="button" data-cancel>Cancelar</button>
				</div>`;

			const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]')!;
			const purchaseInput = form.querySelector<HTMLInputElement>('input[name="purchaseAmount"]')!;
			const saleInput = form.querySelector<HTMLInputElement>('input[name="saleAmount"]')!;
			const purchaseSelect = form.querySelector<HTMLSelectElement>('select[name="purchaseCurrency"]')!;
			const saleSelect = form.querySelector<HTMLSelectElement>('select[name="saleCurrency"]')!;
			const limitInput = form.querySelector<HTMLInputElement>('input[name="profitLimit"]')!;

			nameInput.value = product.name;
			purchaseInput.value = product.purchaseAmount;
			saleInput.value = product.saleAmount;
			limitInput.value = product.profitLimit;

			for (const select of [purchaseSelect, saleSelect]) {
				for (const code of currencies) {
					const option = document.createElement('option');
					option.value = code;
					option.textContent = code;
					select.append(option);
				}
			}
			purchaseSelect.value = product.purchaseCurrency;
			saleSelect.value = product.saleCurrency;

			form.querySelector('[data-cancel]')?.addEventListener('click', () => {
				renderProducts(currentProducts);
			});

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				const error = form.querySelector<HTMLElement>('.form-error');
				if (error) error.hidden = true;

				const payload = {
					name: nameInput.value.trim(),
					purchaseAmount: purchaseInput.value.trim(),
					purchaseCurrency: purchaseSelect.value,
					saleAmount: saleInput.value.trim(),
					saleCurrency: saleSelect.value,
					profitLimit: limitInput.value.trim() || '10',
				};

				if (!payload.name || !payload.purchaseAmount || !payload.saleAmount || !payload.purchaseCurrency || !payload.saleCurrency) {
					if (error) {
						error.textContent = 'Completa nombre, precios y monedas.';
						error.hidden = false;
					}
					return;
				}

				try {
					await request(`/products/${product.id}`, { method: 'PATCH', body: JSON.stringify(payload) }, session?.token);
					await loadData();
				} catch (problem) {
					if (error) {
						error.textContent = problem instanceof Error ? problem.message : 'No se pudo guardar.';
						error.hidden = false;
					}
				}
			});

			const cell = document.createElement('td');
			cell.colSpan = 10;
			cell.append(form);
			card.textContent = '';
			card.append(cell);
		}

		type ProductPage = { products: Product[]; page: number; pageSize: number; total: number; pages: number };

		async function loadData(page = currentPage) {
			const [productsResponse, rateResponse, settingsResponse, currenciesResponse] = await Promise.all([
				request<ProductPage>(`/products?page=${page}`, {}, session?.token),
				request<{ currency: string; rate: Rate | null }>('/rate', {}, session?.token),
				request<{ profitMode: 'margin' | 'markup' | null }>('/settings', {}, session?.token),
				request<{ currencies: string[] }>('/currencies', {}, session?.token),
			]);

			profitMode = settingsResponse.profitMode;
			fillCurrencies(currenciesResponse.currencies);
			renderMode();
			renderRate(rateResponse.rate);
			currentPage = productsResponse.page;
			totalPages = productsResponse.pages;
			totalItems = productsResponse.total;
			renderProducts(productsResponse.products);
			renderPagination();
		}

		function renderPagination() {
			if (!pagination || !pageInfo || !prevPage || !nextPage) return;
			// The controls stay visible as soon as there is data, so the person always sees where they are.
			pagination.hidden = totalItems === 0;
			const label = totalItems === 1 ? '1 producto' : `${totalItems} productos`;
			pageInfo.textContent = `Página ${currentPage} de ${totalPages} · ${label}`;
			prevPage.disabled = currentPage <= 1;
			nextPage.disabled = currentPage >= totalPages;
		}

		function enterApp(next: Session) {
			session = next;
			sessionStorage.setItem('inventory-session', JSON.stringify(next));
			if (loginView) loginView.hidden = true;
			if (homeView) homeView.hidden = false;
			if (welcomeTitle) welcomeTitle.textContent = `Hola, ${next.name}`;
			void loadAlerts().catch(() => {});
			const ratePanel = document.querySelector<HTMLElement>('#rate-panel');
			if (ratePanel) ratePanel.hidden = next.role !== 'admin';
			const modePanel = document.querySelector<HTMLElement>('#mode-panel');
			if (modePanel) modePanel.hidden = next.role !== 'admin';
			void loadData().catch(handleExpired);
		}

		function leaveApp() {
			session = null;
			sessionStorage.removeItem('inventory-session');
			if (homeView) homeView.hidden = true;
			if (loginView) loginView.hidden = false;
			document.querySelector<HTMLInputElement>('#user-name')?.focus();
		}

		function handleExpired(error: unknown) {
			const message = error instanceof Error ? error.message : 'Error inesperado';
			// Keep the failure visible at the top instead of leaving a permanent "Cargando".
			if (rateStatus) rateStatus.textContent = `No se pudo cargar la tasa: ${message}`;
			if (!isAdmin) {
				showError(productError, message);
				return;
			}
			if (/token|not allowed|credentials/i.test(message)) {
				leaveApp();
				showError(loginError, 'La sesión terminó. Vuelve a entrar.');
				return;
			}
			showError(productError, message);
		}

		loginForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors();
			const data = new FormData(loginForm);
			const name = String(data.get('name') ?? '').trim();
			const password = String(data.get('password') ?? '');

			if (!name || !password) {
				showError(loginError, 'Escribe tu nombre y contraseña.');
				return;
			}

			if (loginSubmit) loginSubmit.disabled = true;
			try {
				const result = await request<{ token: string; role: string }>('/session', {
					method: 'POST',
					body: JSON.stringify({ name, password }),
				});
				loginForm.reset();
				enterApp({ token: result.token, name, role: result.role });
			} catch {
				showError(loginError, 'Nombre o contraseña incorrectos.');
			} finally {
				if (loginSubmit) loginSubmit.disabled = false;
			}
		});

		logoutButton?.addEventListener('click', leaveApp);

		readAllButton?.addEventListener('click', () => {
			void markAlertsRead().catch(() => {});
		});

		enableNotifications?.addEventListener('click', async () => {
			try {
				await enablePush();
			} catch (error) {
				alert(error instanceof Error ? error.message : 'No se pudieron activar los avisos.');
			}
		});

		// Keep the screen current without a manual reload. Editing pauses the refresh so input is never lost.
		const REFRESH_MS = 20_000;
		let refreshing = false;

		function isBusy(): boolean {
			if (document.querySelector('.product-edit-form')) return true;
			const active = document.activeElement as HTMLElement | null;
			return Boolean(active && (active.tagName === 'INPUT' || active.tagName === 'SELECT'));
		}

		async function refreshQuietly(): Promise<void> {
			if (refreshing) return;
			if (document.visibilityState !== 'visible') return;
			if (isBusy()) return;
			refreshing = true;
			try {
				await loadData();
				await loadAlerts();
			} catch {
				// A transient failure must not disturb the screen.
			} finally {
				refreshing = false;
			}
		}

		setInterval(() => void refreshQuietly(), REFRESH_MS);
		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible') void refreshQuietly();
		});
		window.addEventListener('focus', () => void refreshQuietly());

		prevPage?.addEventListener('click', () => {
			if (currentPage > 1) void loadData(currentPage - 1);
		});

		nextPage?.addEventListener('click', () => {
			if (currentPage < totalPages) void loadData(currentPage + 1);
		});

		rateForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors();
			if (!session || !rateValue) return;

			const value = rateValue.value.trim();
			if (!value) {
				showError(rateError, 'Escribe la tasa.');
				return;
			}

			try {
				const result = await request<{ rate: Rate }>('/rate', {
					method: 'PUT',
					body: JSON.stringify({ cupPerUsd: value }),
				}, session?.token);
				renderRate(result.rate);
				rateForm.reset();
				await loadData();
			} catch (error) {
				showError(rateError, error instanceof Error ? error.message : 'No se pudo guardar la tasa.');
			}
		});

		modeForm?.addEventListener('change', async (event) => {
			clearErrors();
			if (!session) return;
			const target = event.target as HTMLInputElement;
			if (target.name !== 'profitMode') return;

			try {
				await request('/settings', { method: 'PUT', body: JSON.stringify({ profitMode: target.value }) }, session?.token);
				profitMode = target.value as 'margin' | 'markup';
				await loadData();
			} catch (error) {
				showError(modeError, error instanceof Error ? error.message : 'No se pudo guardar la preferencia.');
			}
		});

		productForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors();

			const data = new FormData(productForm);
			const payload = {
				name: String(data.get('name') ?? '').trim(),
				purchaseAmount: String(data.get('purchaseAmount') ?? '').trim(),
				saleAmount: String(data.get('saleAmount') ?? '').trim(),
				purchaseCurrency: String(data.get('purchaseCurrency') ?? '').trim(),
				saleCurrency: String(data.get('saleCurrency') ?? '').trim(),
				profitLimit: String(data.get('profitLimit') ?? '').trim() || '10',
			};

			if (!payload.name || !payload.purchaseAmount || !payload.saleAmount) {
				showError(productError, 'Completa nombre, compra y venta.');
				return;
			}
			if (!payload.purchaseCurrency || !payload.saleCurrency) {
				showError(productError, 'Elige la moneda de compra y la de venta.');
				return;
			}

			if (productSubmit) productSubmit.disabled = true;
			try {
				await request('/products', { method: 'POST', body: JSON.stringify(payload) }, session?.token);
				productForm.reset();
				await loadData();
			} catch (error) {
				showError(productError, error instanceof Error ? error.message : 'No se pudo guardar el producto.');
			} finally {
				if (productSubmit) productSubmit.disabled = false;
			}
		});

		productList?.addEventListener('click', async (event) => {
			const target = event.target as HTMLElement;
			const card = target.closest<HTMLElement>('.product-row');
			if (!card) return;

			if (target.classList.contains('product-edit')) {
				const product = currentProducts.find((item) => item.id === card.dataset.id);
				if (product) startEdit(card, product);
				return;
			}

			if (!target.classList.contains('product-remove')) return;
			const id = card.dataset.id;
			if (!id) return;

			try {
				await request(`/products/${id}`, { method: 'DELETE' }, session?.token);
				// Deleting the last item of a page must land on a page that still has content.
				if (currentProducts.length === 1 && currentPage > 1) {
					await loadData(currentPage - 1);
				} else {
					await loadData();
				}
			} catch (error) {
				handleExpired(error);
			}
		});

		importPreview?.addEventListener('click', async () => {
			clearErrors();
			if (importPreview) importPreview.disabled = true;
			try {
				renderImport(await sendImport('preview'));
			} catch (error) {
				showError(importError, error instanceof Error ? error.message : 'No se pudo leer el archivo.');
			} finally {
				if (importPreview) importPreview.disabled = false;
			}
		});

		importApply?.addEventListener('click', async () => {
			clearErrors();
			if (importApply) importApply.disabled = true;
			try {
				const result = await sendImport('apply');
				renderImport(result);
				if (importSummary) {
					importSummary.textContent = `Importadas ${result.inserted ?? 0} filas. ${result.summary.errors} con error y ${result.summary.duplicates} duplicadas quedaron fuera.`;
				}
				await loadData();
			} catch (error) {
				showError(importError, error instanceof Error ? error.message : 'No se pudo importar.');
			} finally {
				if (importApply) importApply.disabled = false;
			}
		});

		if (!isAdmin) {
			if (loginView) loginView.hidden = true;
			if (homeView) homeView.hidden = false;
			if (welcomeTitle) welcomeTitle.textContent = 'Inventario';
			if (logoutButton) logoutButton.hidden = true;
			void loadData().catch(handleExpired);
			void loadAlerts().catch(() => {});
		} else {
			const stored = sessionStorage.getItem('inventory-session');
			if (stored) {
				try {
					const parsed = JSON.parse(stored) as Session;
					if (parsed?.token && parsed?.name) enterApp(parsed);
				} catch {
					sessionStorage.removeItem('inventory-session');
				}
			}
		}
	</script>

	<style>
