---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title = 'Inventario',
	description = 'Inventario privado del negocio: tasa del día, productos, ganancia en CUP y avisos cuando un producto llega a su límite.',
	image = 'https://live-inventory-orcin.vercel.app/og-image.png',
	noindex = false,
} = Astro.props;

const site = 'https://live-inventory-orcin.vercel.app';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#174f7a" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		{!noindex && (
			<>
			<meta property="og:type" content="website" />
			<meta property="og:site_name" content="Inventario" />
			<meta property="og:title" content={title} />
			<meta property="og:description" content={description} />
			<meta property="og:url" content={`${site}/`} />
			<meta property="og:image" content={image} />
			<meta property="og:image:width" content="1200" />
			<meta property="og:image:height" content="630" />
			<meta property="og:image:alt" content="Inventario: tasa del día, productos y ganancias en CUP" />
			<meta property="og:locale" content="es_ES" />

			<meta name="twitter:card" content="summary_large_image" />
			<meta name="twitter:title" content={title} />
			<meta name="twitter:description" content={description} />
			<meta name="twitter:image" content={image} />
			</>
		)}
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--color-page: #f3f1eb;
		--color-surface: #fcfaf5;
		--color-ink: #242b2a;
		--color-muted: #485553;
		--color-accent: #174f7a;
		--color-accent-hover: #123e60;
		--color-on-accent: #f9f7f1;
		--color-border: #65716e;
		--radius-panel: 14px;
		--radius-field: 6px;
		--radius-button: 5px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html,
	body {
		min-height: 100%;
		margin: 0;
	}

	body {
		background: var(--color-page);
		color: var(--color-ink);
		font-family: 'Source Sans 3', 'Segoe UI', sans-serif;
		font-size: 1rem;
		line-height: 1.5;
	}

	button,
	input {
		font: inherit;
	}

	:focus-visible {
		outline: 3px solid var(--color-accent);
		outline-offset: 3px;
	}

	[hidden] {
		display: none !important;
	}
</style>
